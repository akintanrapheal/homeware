generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  // Pooled connection — what the app queries through at runtime. The Neon
  // Vercel integration injects this automatically.
  url = env("DATABASE_URL")

  // Direct (unpooled) connection. Migrations and `db push` cannot run through
  // PgBouncer, so Prisma needs this separately. Neon injects it as
  // DATABASE_URL_UNPOOLED; locally you can point both at the same string.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  brand       String   @default("Homeware & Co")
  category    String // cookware | knives | appliances | storage | tableware | glassware | textiles
  family      String // cast iron | stainless steel | stoneware | glass | linen | …
  description String
  specs       String[] @default([])
  care        String[] @default([])
  inBox       String[] @default([])
  sizeLabel   String?
  price       Int // kobo-free: whole Naira
  compareAt   Int? // slashed "was" price, whole Naira
  stock       Int      @default(0)
  imageUrl    String?
  accent      String   @default("clay") // clay | sage | sand | slate | copper | ink
  featured    Boolean  @default(false)
  bestseller  Boolean  @default(false)
  rating      Float    @default(4.8)
  reviewCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems OrderItem[]

  @@index([category])
  @@index([featured])
}

/**
 * Categories are data, not code, so the shop owner can add "Bakeware" without a
 * deploy. Product.category holds the slug rather than a foreign key: deleting a
 * category should orphan its products for re-filing, never delete stock.
 */
/**
 * A single row holding everything the shop owner can edit without a deploy.
 * Kept as one row rather than a key/value bag so the fields stay typed and a
 * typo in a key cannot silently blank the storefront.
 *
 * Secrets live here too. They are never sent to the browser: the settings API
 * returns whether a key is set, not the key itself.
 */
model StoreSettings {
  id String @id @default("singleton")

  storeName   String @default("Homeware & Co")
  tagline     String @default("For the home you actually live in.")
  description String @default("")

  whatsapp  String @default("")
  email     String @default("")
  phone     String @default("")
  instagram String @default("")
  tiktok    String @default("")
  address   String @default("")
  hours     String @default("")

  freeDeliveryThreshold Int @default(120000)
  announcement          String @default("")

  paystackPublicKey String?
  paystackSecretKey String?
  paystackEnabled   Boolean @default(false)

  emailProvider  String  @default("resend")
  emailApiKey    String?
  emailFrom      String?
  emailReplyTo   String?
  emailOnOrder   Boolean @default(true)
  notifyStore    Boolean @default(true)

  updatedAt DateTime @updatedAt
}

/** Delivery zones, editable rather than compiled in. */
model DeliveryZoneRow {
  id        String   @id @default(cuid())
  slug      String   @unique
  label     String
  fee       Int      @default(0)
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
}

/**
 * Fixed-window rate limiting. Serverless instances share nothing in memory, so
 * the counter has to live somewhere both of them can see.
 */
model RateLimit {
  id        String   @id @default(cuid())
  bucket    String
  identity  String
  count     Int      @default(0)
  expiresAt DateTime

  @@unique([bucket, identity])
  @@index([expiresAt])
}

/** Who changed what. One shared admin password means no accountability without it. */
model AuditLog {
  id        String   @id @default(cuid())
  action    String
  target    String?
  summary   String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/** Single-use, short-lived. The token itself is stored hashed. */
model PasswordResetToken {
  id         String   @id @default(cuid())
  customerId String
  tokenHash  String   @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([expiresAt])
}

model Category {
  id        String   @id @default(cuid())
  slug      String   @unique
  label     String
  blurb     String   @default("")
  group     String   @default("kitchen")
  /** Which generated silhouette to draw for products with no photo. */
  shape     String   @default("cookware")
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
}

model Customer {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  address      String?
  city         String?
  zone         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders Order[]
  resetTokens PasswordResetToken[]

  @@index([email])
}

model Order {
  id            String      @id @default(cuid())
  reference     String      @unique
  /** Client-supplied key so a double-tapped checkout cannot create two orders. */
  idempotencyKey String?    @unique
  // Null for guest checkout, which stays a first-class path — the snapshot
  // fields below are always written so an order is complete on its own.
  customerId    String?
  customerName  String
  email         String
  phone         String
  address       String
  city          String
  state         String
  note          String?
  deliveryFee   Int         @default(0)
  subtotal      Int
  total         Int
  paymentMethod String      @default("whatsapp") // whatsapp | paystack
  status        OrderStatus @default(PENDING)
  paidAt        DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  items    OrderItem[]
  customer Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@index([customerId])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String?
  name      String
  slug      String
  price     Int
  quantity  Int

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model Message {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  body      String
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())
}

enum OrderStatus {
  PENDING
  PAID
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
}
