# =====================================================================
#  Homeware & Co — environment variables
#  Copy to `.env` for local use. On Vercel, set these under
#  Project → Settings → Environment Variables.
# =====================================================================

# ---- Database (Neon Postgres via the Vercel Marketplace) ----
# Vercel Postgres was discontinued in Dec 2024; Neon is its replacement.
# When you add the Neon integration on Vercel, BOTH of these are injected
# into your project automatically — you do not type them by hand there.
#
# Locally: copy the connection string from the Neon dashboard. If you only
# have one string, set both variables to it.
#
#   DATABASE_URL          → pooled   (host contains "-pooler") — used at runtime
#   DATABASE_URL_UNPOOLED → direct   (no "-pooler")            — used by db:push
#
# Leave BOTH unset and the site still runs, serving the bundled catalog.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# ---- Store identity ----
NEXT_PUBLIC_SITE_URL="https://homewareandco.com"
NEXT_PUBLIC_WHATSAPP_NUMBER="2348000000000"   # international format, no + and no spaces
NEXT_PUBLIC_STORE_EMAIL="hello@homewareandco.com"
NEXT_PUBLIC_STORE_PHONE="+234 800 000 0000"
NEXT_PUBLIC_INSTAGRAM="https://instagram.com/homewareandco"
NEXT_PUBLIC_TIKTOK="https://tiktok.com/@homewareandco"

# ---- Paystack ----
# The public key's presence is what enables the card option at checkout.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxx"
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxx"

# ---- Admin dashboard (/admin) ----
ADMIN_PASSWORD="change-me-to-something-long"
ADMIN_SESSION_SECRET="a-long-random-string-at-least-32-characters"
